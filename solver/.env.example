# Copy to .env and fill in PRIVATE_KEY before running `npm run loop` for real.
# Missing PRIVATE_KEY logs a "[recenter:dry-run]" line instead of crashing.
# The addresses below point at the live Monad testnet deployment.

RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=
VAULT_MANAGER_ADDRESS=0x28AC946761572E3b4FeA03163Dc894997b9677FE

HERMES_ENDPOINT=https://hermes.pyth.network
# Hermes 401s without it. Free key at https://www.pyth.network/
HERMES_API_KEY=
POLL_INTERVAL_MS=500
# How often (ms) to permissionlessly harvest fees on an open band into idle
# balance — see loop.ts's maybeCollectFees. Each harvest splits 80/15/5
# (depositors/protocol treasury/whoever calls it) — see PairVault.sol's
# PROTOCOL_BPS/KEEPER_BPS. Default 1 hour.
COLLECT_FEES_INTERVAL_MS=3600000

# Pyth price-feeds contract on Monad testnet. Only used to size the update fee
# for recenterWithPriceUpdate (excess is refunded on-chain), so the default is
# fine to leave as-is.
PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43

# Which tiers to monitor (comma-separated). That's the only per-tier config
# needed — each tier's pool, Pyth feed ids, and tick spacing are all public
# immutables read live off the vault and pool contracts themselves (see
# loop.ts's resolveVaultMeta), not something to keep in sync by hand here.
TIERS=1,2
